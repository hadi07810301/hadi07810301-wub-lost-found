rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read: if true;

      // Anyone (signed in anonymously) can create a post as themselves.
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.type in ['lost', 'found']
        && request.resource.data.status == 'open'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 80
        && (request.resource.data.photo == null || request.resource.data.photo.size() < 400000);

      // Only the person who posted can change the status or delete it.
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['open', 'resolved'];
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
  }
}
